{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Module 1 Directory Scanner",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/dist/main.js",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build TypeScript scanner",
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
